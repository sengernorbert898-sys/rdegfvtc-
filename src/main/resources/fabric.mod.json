	"authors": [
		"Reel Comfort contributors"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/reel-comfort"
	},
	"license": "MIT",
	"icon": "assets/reelcomfort/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.reelcomfort.ReelComfortClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
